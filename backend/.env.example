# Digital Evidence Intelligent Interface - Backend Configuration
APP_NAME="Digital Evidence Vault API"
APP_ENV=development
DEBUG=True
API_V1_STR=/api/v1
SECRET_KEY=change_this_to_a_secure_random_key_in_production

# Storage
UPLOAD_DIR=./storage_vault
MAX_UPLOAD_SIZE_BYTES=52428800 # 50 MB

# Database
# Default is SQLite for fast local development; switch to PostgreSQL in production
DATABASE_URL=sqlite:///./evidence_vault.db
# DATABASE_URL=postgresql://user:password@localhost:5432/evidence_db

# Optional AI & OCR Engine configurations
TESSERACT_CMD=
OPENAI_API_KEY=
GEMINI_API_KEY=

# ─── Qwen AI Model Configuration ───────────────────────────────────────────────
# Path to your fine-tuned Qwen GGUF model file.
# Relative to the backend/ directory, or use an absolute path.
#
# Expected file: Qwen2.5-3B-Instruct.Q4_K_M.gguf (~1.8 GB)
# Place the file at: backend/models/Qwen2.5-3B-Instruct.Q4_K_M.gguf
#
QWEN_MODEL_PATH=./models/Qwen2.5-3B-Instruct.Q4_K_M.gguf
#
# CPU inference settings (tuned for 8 GB RAM Windows PC):
QWEN_N_CTX=4096
QWEN_N_THREADS=4
QWEN_MAX_TOKENS=1024

